# 依赖（默认忽略；但前端完整依赖按要求提交 git，便于新任务 clone 即构建）
node_modules/
!frontend/node_modules/
backend/__pycache__/
__pycache__/
*.pyc

# 构建产物（可重建）
frontend/dist/

# 日志
*.log
/backend/*.log

# 编辑器/IDE
.idea/
.vscode/
.DS_Store

# 虚拟环境
.venv/
venv/
# 旧版 venv 备份（python 3.9 → 3.13 迁移时备份）
backend/.venv_py39_backup/

# 本地密钥与数据库文件（真实 .env 禁止入库；.env.example 可入库作为模板）
.env
.env.local
# 后端自生成的签名密钥（首次启动自动生成，含随机值，禁止入库）
.auth_secret
*.db
*.sqlite3

# 上传文件存档（发票/发票箱原文件，含真实涉税数据，禁止入库）
uploads/

# 工具自身目录 / 本地产物目录（非项目源码，禁止入库）
.workbuddy/
deliverables/

# 前端编译产物（双识别 / 发票测试构建临时目录）
frontend/.reparse-build/
frontend/.invoice-test-build*/

